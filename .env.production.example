# ============================================
# PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================
# Copy this to .env.production (DO NOT COMMIT)
# Set all values for your production environment
# Last Updated: January 2025

# ============================================
# DATABASE CONFIGURATION
# ============================================
# Full Supabase connection string
DATABASE_URL=postgresql://<db_user>:<db_password>@<project_ref>.postgres.supabase.co:5432/<database_name>?sslmode=require

# Supabase connection details
DB_USER=postgres.<project_ref>
DB_PASSWORD=<your-new-strong-database-password>
DB_HOST=<project_ref>.postgres.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_SSL=true

# ============================================
# APPLICATION SETTINGS
# ============================================
NODE_ENV=production

# Backend API Settings
BACKEND_PORT=3000
BACKEND_HOST=0.0.0.0

# Frontend Settings
FRONTEND_PORT=8000
FRONTEND_HOST=0.0.0.0

# ============================================
# SECURITY & CORS
# ============================================
# Replace with your actual production domain
CORS_ORIGIN=https://yourdomain.com
CORS_CREDENTIALS=true

# ============================================
# OPTIONAL: Database Seeding
# ============================================
# Set to false in production or remove this line
SEED_DB=false

# ============================================
# OPTIONAL: Authentication (if applicable)
# ============================================
# Add any JWT secrets, API keys, or auth tokens here
# JWT_SECRET=<generate-a-strong-random-string>

# ============================================
# IMPORTANT NOTES
# ============================================
# 1. NEVER commit this file with actual values
# 2. Store this securely in your hosting platform's environment variables
# 3. Use strong, randomly generated passwords (minimum 20 characters)
# 4. Rotate credentials regularly
# 5. Keep DATABASE_URL and DB_PASSWORD in sync
# 6. Always use sslmode=require for production connections
# 7. Enable SSL/TLS for all external connections

# ============================================
# RECOMMENDED HOSTING PLATFORMS
# ============================================
# Vercel (for frontend): Set environment variables in Dashboard → Settings → Environment Variables
# AWS (for backend): Use AWS Secrets Manager or Systems Manager Parameter Store
# Heroku (for backend): Use Dashboard → Settings → Config Vars
# Railway (full stack): Set environment variables in Project Settings
# Render (full stack): Set environment variables in Environment
