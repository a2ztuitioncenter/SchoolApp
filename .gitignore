# ============================================================================
# ⚠️ ENVIRONMENT FILES - CRITICAL FOR SECURITY
# ============================================================================
# Never commit environment files with credentials
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
.myenv
.myenv.local
.myenv.*.local

# But DO commit example files for developers
!.env.example
!.env.production.example
!.env.development.example

# ============================================================================
# DEPENDENCIES & LOCK FILES
# ============================================================================
node_modules/
*/node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml
bun.lockb
bun.lock
npm-shrinkwrap.json
.npm/
.yarn/
.pnpm-store/

