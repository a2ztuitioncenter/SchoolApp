# ============================================================================
# UPLOAD DIRECTORIES - Keep structure, ignore contents
# ============================================================================
uploads/
backend/uploads/
frontend/uploads/
# Keep .gitkeep files to maintain directory structure
!uploads/.gitkeep
!uploads/homework/.gitkeep
!uploads/materials/.gitkeep
!uploads/notifications/.gitkeep
!backend/uploads/.gitkeep
!backend/uploads/homework/.gitkeep
!backend/uploads/materials/.gitkeep
!backend/uploads/notifications/.gitkeep
frontend/uploads/*
!frontend/uploads/.gitkeep

# ============================================================================
# CACHE DIRECTORIES
# ============================================================================
.cache/
.eslintcache/
.next/cache/
.tsc-cache/
eslint-cache/
jest_cache/
.parcel-cache/

# ============================================================================
# DEPENDENCY MANAGER SPECIFIC
# ============================================================================
.npm-cache/
.yarn-cache/
.pnpm-workspace.yaml.local

# ============================================================================
# VERCEL/DEPLOYMENT SPECIFIC
# ============================================================================
.vercel/
.vercel_build/

# ============================================================================
# SECURITY - Hide all hidden files by default
# ============================================================================
.*

# BUT KEEP these important files
!.gitignore
!.gitattributes
!.env.example
!.env.production.example
!.env.development.example
!.github/
!.husky/
!.vscode/
!.editorconfig

