# ============================================
# SPECIAL RULES FOR SECURITY
# ============================================
# These rules are critical for production security

# ANY hidden files that might contain credentials
.*

# But KEEP important git files
!.gitignore
!.gitattributes
!.env.example
!.env.production.example

# Exclude all config files with credentials
# except examples
config/*.local.*
config/*secret*
!config/example*
