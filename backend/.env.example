# General
PORT=3000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_here

# Database
DATABASE_URL=postgresql://user:password@host:port/dbname

# Admin Setup
ADMIN_PHONE=1234567890
ADMIN_PASSWORD=admin_password
ADMIN_USERNAME=admin

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:5173,https://school-app-one-kappa.vercel.app

# Google Drive (Optional)
GOOGLE_SERVICE_ACCOUNT_PROJECT_ID=your_project_id
GOOGLE_SERVICE_ACCOUNT_EMAIL=your_service_account_email
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=your_private_key
GOOGLE_DRIVE_ROOT_FOLDER_NAME=Tuition App Storage

# Debugging
DEBUG=true
