# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=123456
DB_NAME=tuition_app

# Server Configuration
PORT=3000
NODE_ENV=development

# CORS Configuration
CORS_ORIGIN=http://localhost:8000,http://localhost:3000,http://localhost:4000

# Database Initialization (create tables and default admin user)
INITIALIZE_DB=true

# Seed database with sample data
SEED_DB=true

# Default Admin Credentials (for first-time setup)
ADMIN_PHONE=9999999999
ADMIN_PASSWORD=admin123
